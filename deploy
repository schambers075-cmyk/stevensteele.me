{
  "name": "stevensteele-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^4.16.0"
  }
}
---
const { title = 'Steven Steele', description = 'Talk Show Host | Recording Artist | Marketing Director' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0a0a; color: #f5f5f5; line-height: 1.6; }
    header { background: linear-gradient(135deg, #1a1a1a 0%, #2d1b0e 100%); padding: 4rem 2rem; text-align: center; border-bottom: 3px solid #c9a227; }
    .profile { width: 180px; height: 180px; border-radius: 50%; object-fit: cover; border: 4px solid #c9a227; margin-bottom: 1.5rem; }
    h1 { font-size: 3rem; font-weight: 700; letter-spacing: -1px; margin-bottom: 0.5rem; }
    .tagline { font-size: 1.25rem; color: #c9a227; font-weight: 500; }
    nav { background: #111; padding: 1rem; text-align: center; position: sticky; top: 0; z-index: 100; }
    nav a { color: #f5f5f5; text-decoration: none; margin: 0 1.5rem; font-weight: 500; transition: color 0.3s; }
    nav a:hover { color: #c9a227; }
    main { max-width: 900px; margin: 0 auto; padding: 4rem 2rem; }
    h2 { font-size: 2rem; margin-bottom: 1.5rem; color: #c9a227; border-bottom: 2px solid #333; padding-bottom: 0.5rem; }
    .about p { margin-bottom: 1rem; font-size: 1.1rem; }
    .links { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 2rem; }
    .link-card { background: #1a1a1a; padding: 1.5rem; border-radius: 12px; text-align: center; border: 1px solid #333; transition: transform 0.2s, border-color 0.2s; }
    .link-card:hover { transform: translateY(-4px); border-color: #c9a227; }
    .link-card a { color: #f5f5f5; text-decoration: none; font-weight: 600; display: block; }
    footer { text-align: center; padding: 2rem; background: #111; color: #888; font-size: 0.9rem; }
    @media (max-width: 600px) { h1 { font-size: 2rem; } nav a { display: block; margin: 0.5rem 0; } }
  </style>
</head>
<body>
  <header>
    <img src="/profile.jpg" alt="Steven Steele" class="profile" />
    <h1>Steven Steele</h1>
    <p class="tagline">Talk Show Host | Recording Artist | Marketing Director</p>
  </header>
  <nav>
    <a href="#about">About</a>
    <a href="#links">Connect</a>
    <a href="#work">Work</a>
  </nav>
  <main>
    <slot />
  </main>
  <footer>
    <p>stevensteele.me — Personal site. All content based on public information.</p>
  </footer>
</body>
</html>
